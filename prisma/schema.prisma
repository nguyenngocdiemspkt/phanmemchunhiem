generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentStatus {
  ACTIVE // Đang học
  TRANSFERRED // Chuyển trường
  LEFT // Nghỉ học
}

enum NoteType {
  POSITIVE // Hành động tích cực
  PROGRESS // Chuyển biến / tiến bộ
  CONCERN // Điều cần quan tâm (chỉ giáo viên thấy)
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  passwordHash       String
  fullName           String
  role               Role
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(true)
  email              String?
  phone              String?
  createdAt          DateTime    @default(now())
  /// Thời điểm cập nhật ảnh đại diện (null = chưa có ảnh); dùng làm tham số chống cache
  avatarUpdatedAt    DateTime?
  avatar             UserAvatar?

  student           Student?
  homeroomClasses   Classroom[]        @relation("Homeroom")
  templates         FormTemplate[]
  feedbacks         Feedback[]
  notes             Note[]
  emulationRecords  EmulationRecord[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  classTransfers    ClassTransfer[]
  reportDecisions   ScoreReport[]
}

/// Năm học. Tuần học được đánh số từ startDate (tuần 1 là tuần chứa startDate).
model SchoolYear {
  id             String   @id @default(cuid())
  /// Dạng "2026-2027", là khóa để lớp tham chiếu
  name           String   @unique
  startDate      DateTime
  semester2Start DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  /// Năm học đã kết thúc: dữ liệu chỉ còn được xem
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())

  classes Classroom[]
}

model Classroom {
  id                String      @id @default(cuid())
  name              String
  schoolYear        String
  year              SchoolYear  @relation(fields: [schoolYear], references: [name], onUpdate: Cascade)
  homeroomTeacherId String?
  homeroomTeacher   User?       @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  /// Số tổ của lớp, dùng cho thi đua
  groupCount        Int         @default(4)
  /// Tên tổ do GV đặt: ["Tổ Ong vàng", ...] theo thứ tự tổ 1..groupCount; thiếu thì hiển thị "Tổ n"
  groupNames        Json?
  /// Điểm gốc mỗi tuần của mỗi học sinh khi chấm điểm theo tiêu chí
  baseScore         Int         @default(100)
  /// Ngưỡng xếp loại tuần: >= ratingGood là Tốt, >= ratingFair là Khá, >= ratingPass là Đạt, còn lại Cần cố gắng
  ratingGood        Int         @default(100)
  ratingFair        Int         @default(95)
  ratingPass        Int         @default(85)
  /// Mỗi sao của tiêu chí xếp hạng tổ được quy ra bao nhiêu điểm
  starPoints        Int         @default(10)
  /// Điểm cộng (thi đua tổ + vườn) cho bạn được bình chọn tuyên dương tuần; 0 = không cộng
  commendPoints     Int         @default(3)
  /// Khu vườn lớp: chu kỳ thu hoạch và mốc điểm nuôi cây của từng giai đoạn
  gardenCycle       GardenCycle @default(SEMESTER)
  /// Điểm vườn khởi đầu của mỗi học sinh (cây là hạt giống)
  gardenStart       Int         @default(100)
  /// Dưới gardenWilt: cây héo; dưới gardenDry: khô lá
  gardenWilt        Int         @default(80)
  gardenDry         Int         @default(70)
  /// Từ gardenSprout: nảy mầm; từ gardenTwoLeaves: có 2 lá, sau đó mỗi gardenLeafStep điểm thêm 1 lá
  gardenSprout      Int         @default(105)
  gardenTwoLeaves   Int         @default(110)
  gardenLeafStep    Int         @default(3)
  /// Từ gardenMature: cây trưởng thành, ra trái; vượt mốc này mỗi gardenFruitStep điểm thêm 1 trái
  gardenMature      Int         @default(140)
  gardenFruitStep   Int         @default(5)
  /// GVCN bật/tắt phòng chat của lớp trong vườn
  chatEnabled       Boolean     @default(true)
  createdAt         DateTime    @default(now())

  students            Student[]
  surveys             Survey[]
  emulationCategories EmulationCategory[]
  emulationRecords    EmulationRecord[]
  transfersOut        ClassTransfer[]     @relation("TransferFrom")
  enrollments         Enrollment[]
  groupCriteria       GroupCriterion[]
  groupAwards         GroupAward[]
  goodDeeds           GoodDeed[]
  harvests            GardenHarvest[]
  polls               Poll[]
  chatMessages        ChatMessage[]
  commendationVotes   CommendationVote[]
  transfersIn         ClassTransfer[]     @relation("TransferTo")

  @@unique([name, schoolYear])
}

model Student {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId         String
  classroom       Classroom     @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentCode     String?
  dateOfBirth     String?
  gender          String?
  address         String?
  parentName      String?
  parentPhone     String?
  /// Tổ (1..groupCount), null = chưa phân tổ
  groupNo         Int?
  /// Cán sự lớp: được ghi điểm thi đua
  isMonitor       Boolean       @default(false)
  /// Nhân vật trong vườn lớp: { skin, hair, hairColor, shirt, pants, acc }
  character       Json?
  /// Hạt giống đang trồng và chu kỳ của lần trồng (vd "2026-2027-HK1")
  seedType        String?
  seedCycle       String?
  /// Vị trí nhân vật trên bản đồ vườn (ô lưới), cập nhật khi em di chuyển
  posX            Int?
  posY            Int?
  posAt           DateTime?
  /// Tổ trưởng: được nhận xét và đề xuất bổ sung vi phạm cho tổ viên (GV xác nhận mới tính)
  isGroupLeader   Boolean       @default(false)
  /// Mã bí mật trong đường link phụ huynh xem kết quả (/ph/<mã>), không cần đăng nhập
  parentToken     String?       @unique
  status          StudentStatus @default(ACTIVE)
  statusChangedAt DateTime?
  /// Ghi chú của giáo viên (học sinh không thấy)
  note            String?

  transfers             ClassTransfer[]
  enrollments           Enrollment[]
  responses             Response[]
  scoreReports          ScoreReport[]      @relation("ReportTarget")
  reportsMade           ScoreReport[]      @relation("ReportAuthor")
  deedsDone             GoodDeed[]         @relation("DeedAuthor")
  deedsReceived         GoodDeed[]         @relation("DeedBeneficiary")
  harvests              GardenHarvest[]
  featureRequests       FeatureRequest[]
  pollVotes             PollVote[]
  chatMessages          ChatMessage[]
  commendationsGiven    CommendationVote[] @relation("CommendationVoter")
  commendationsReceived CommendationVote[] @relation("CommendationNominee")
  notes                 Note[]
  emulationRecords      EmulationRecord[]

  @@index([classId])
}

/// Mẫu phiếu. questions là mảng Question (xem src/lib/questions.ts)
model FormTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  questions   Json
  isShared    Boolean  @default(false)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  surveys Survey[]
}

/// Một đợt tự đánh giá của một lớp. questions là bản chụp từ mẫu phiếu
/// lúc tạo, để sửa mẫu về sau không làm sai lệch dữ liệu cũ.
model Survey {
  id         String        @id @default(cuid())
  classId    String
  classroom  Classroom     @relation(fields: [classId], references: [id], onDelete: Cascade)
  templateId String?
  template   FormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title      String
  openAt     DateTime
  closeAt    DateTime
  questions  Json
  /// Bản chụp tiêu chí chấm điểm của lớp lúc tạo đợt: [{ id, name, points }]. null = đợt không chấm điểm
  criteria   Json?
  /// Điểm gốc của đợt (chụp từ lớp lúc tạo)
  baseScore  Int?
  createdAt  DateTime      @default(now())

  responses    Response[]
  scoreReports ScoreReport[]

  @@index([classId, openAt])
}

enum ResponseStatus {
  SUBMITTED // Đã nộp, chờ GV duyệt
  REVISION // GV yêu cầu sửa
  APPROVED // Đã duyệt: khóa phiếu và công bố kết quả
}

model Response {
  id            String         @id @default(cuid())
  surveyId      String
  survey        Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       Json
  score         Float?
  urgent        Boolean        @default(false)
  submittedAt   DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  feedback      Feedback?
  status        ResponseStatus @default(SUBMITTED)
  /// Số lần học sinh tự khai theo từng tiêu chí: { criterionId: số lần }
  selfCounts    Json?
  /// Số lần GV chốt (ghi đè) theo tiêu chí; tiêu chí không có ở đây = tự khai + bổ sung đã chấp nhận
  teacherCounts Json?
  /// Điểm thi đua tuần, tính lại sau mỗi thay đổi
  points        Int?
  /// Lời nhắn khi GV yêu cầu sửa
  reviewNote    String?
  reviewedAt    DateTime?

  @@unique([surveyId, studentId])
  @@index([studentId])
}

model Feedback {
  id               String    @id @default(cuid())
  responseId       String    @unique
  response         Response  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  content          String
  goals            Json
  published        Boolean   @default(false)
  publishedAt      DateTime?
  /// Lần cuối giáo viên bấm nhắn/sao chép tin gửi phụ huynh
  parentNotifiedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

model Note {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type             NoteType
  content          String
  date             DateTime @default(now())
  visibleToStudent Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([studentId, date])
}

/// Danh mục cộng/trừ điểm thi đua của lớp (vd: "Đi học trễ" -2)
model EmulationCategory {
  id        String    @id @default(cuid())
  classId   String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  points    Int
  sortOrder Int       @default(0)

  @@index([classId])
}

/// Một lần ghi điểm thi đua cho cả tổ hoặc một học sinh. Nội dung và điểm được
/// chụp lại lúc ghi, nên sửa danh mục hay xóa học sinh không làm đổi điểm cũ của tổ.
model EmulationRecord {
  id        String    @id @default(cuid())
  classId   String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupNo   Int
  studentId String?
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  content   String
  points    Int
  date      DateTime
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([classId, date])
}

/// Lịch sử chuyển lớp. Phiếu cũ vẫn gắn với đợt của lớp cũ nên không mất.
model ClassTransfer {
  id          String     @id @default(cuid())
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassId String?
  fromClass   Classroom? @relation("TransferFrom", fields: [fromClassId], references: [id], onDelete: SetNull)
  toClassId   String?
  toClass     Classroom? @relation("TransferTo", fields: [toClassId], references: [id], onDelete: SetNull)
  reason      String?
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([studentId])
}

/// Nhật ký thao tác quan trọng: chỉ thêm, không sửa/xóa từ giao diện.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Họ tên người thao tác lúc ghi, giữ lại kể cả khi tài khoản bị xóa
  actorName String?
  /// vd: student.create, student.transfer, teacher.lock
  action    String
  entity    String?
  entityId  String?
  classId   String?
  summary   String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([classId, createdAt])
  @@index([entity, entityId])
}

/// Ảnh đại diện để ở bảng riêng để các truy vấn người dùng thường ngày không phải tải ảnh
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ảnh đã thu nhỏ trên máy người dùng (~256px)
  data      Bytes
  type      String
  updatedAt DateTime @updatedAt
}

enum GardenCycle {
  SEMESTER // Thu hoạch mỗi học kỳ
  YEAR // Thu hoạch cuối năm học
}

/// Kết quả một chu kỳ trồng cây của học sinh (ghi lại khi sang chu kỳ mới)
model GardenHarvest {
  id         String     @id @default(cuid())
  studentId  String
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String?
  classroom  Classroom? @relation(fields: [classId], references: [id], onDelete: SetNull)
  cycle      String
  cycleLabel String
  seedType   String
  /// Điểm vườn cuối chu kỳ và hình dạng cây lúc thu hoạch
  score      Int
  leaves     Int
  fruits     Int
  wilt       Int
  createdAt  DateTime   @default(now())

  @@unique([studentId, cycle])
}

enum GoodDeedKind {
  ONCE // Việc tốt một lần, áp dụng ngay
  CHALLENGE // Thử thách có thời hạn
}

enum GoodDeedStatus {
  ONGOING // Thử thách đang thực hiện
  PENDING // Chờ GVCN duyệt
  APPROVED
  REJECTED
}

/// Phiếu việc tốt học sinh tự tạo; GVCN duyệt và cho điểm (người làm + người được hỗ trợ nếu có)
model GoodDeed {
  id                String         @id @default(cuid())
  classId           String
  classroom         Classroom      @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId          String
  author            Student        @relation("DeedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  beneficiaryId     String?
  beneficiary       Student?       @relation("DeedBeneficiary", fields: [beneficiaryId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  kind              GoodDeedKind
  deadline          DateTime?
  status            GoodDeedStatus
  completedAt       DateTime?
  authorPoints      Int?
  beneficiaryPoints Int?
  teacherNote       String?
  reviewerId        String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([classId, status])
  @@index([authorId])
  @@index([beneficiaryId])
}

enum GroupCriterionKind {
  NO_VIOLATION // Tự động: cả tổ không ai vi phạm trong tuần
  ALL_SUBMITTED // Tự động: mọi thành viên có phiếu tuần đã duyệt
  ALL_GOOD // Tự động: mọi thành viên xếp loại Tốt
  MANUAL // GVCN tick cho tổ đạt mỗi tuần
}

/// Tiêu chí xếp hạng tổ của lớp: tổ đạt trong tuần được cộng (hoặc trừ) số sao
model GroupCriterion {
  id        String             @id @default(cuid())
  classId   String
  classroom Classroom          @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  kind      GroupCriterionKind
  stars     Int                @default(1)
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())

  awards GroupAward[]

  @@index([classId])
}

/// GVCN tick tiêu chí tay cho một tổ trong một tuần. Tên và số sao được chụp lại lúc tick.
model GroupAward {
  id          String          @id @default(cuid())
  classId     String
  classroom   Classroom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  criterionId String?
  criterion   GroupCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  name        String
  stars       Int
  groupNo     Int
  /// 0h thứ Hai (giờ VN) của tuần được tính
  weekStart   DateTime
  authorId    String?
  createdAt   DateTime        @default(now())

  @@unique([criterionId, groupNo, weekStart])
  @@index([classId, weekStart])
}

enum ReportStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Tổ trưởng bổ sung vi phạm (criterionId có giá trị) hoặc nhận xét (criterionId null) cho tổ viên.
/// Chỉ được tính điểm / cho học sinh thấy khi GV chấp nhận.
model ScoreReport {
  id            String       @id @default(cuid())
  surveyId      String
  survey        Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation("ReportTarget", fields: [studentId], references: [id], onDelete: Cascade)
  reporterId    String?
  reporter      Student?     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterName  String
  /// Tiêu chí trong bản chụp của đợt; null = chỉ nhận xét
  criterionId   String?
  criterionName String?
  /// Điểm mỗi lần (chụp lại) và số lần
  points        Int          @default(0)
  times         Int          @default(0)
  note          String?
  status        ReportStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?        @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([surveyId, studentId])
}

/// Học sinh học lớp nào trong từng năm học. Mỗi học sinh chỉ thuộc 1 lớp trong 1 năm học;
/// Student.classId là lớp của lần xếp lớp mới nhất.
model Enrollment {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  classroom  Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear String
  createdAt  DateTime  @default(now())

  @@unique([studentId, schoolYear])
  @@index([classId])
}

/// Cấu hình chung của hệ thống (chỉ quản trị sửa), vd "garden": bộ tham số chuẩn cho vườn lớp của lớp mới
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum FeatureRequestStatus {
  NEW // Mới gửi
  PLANNED // Đã đưa vào kế hoạch
  DONE // Đã làm
  DECLINED // Chưa/không làm
}

/// Học sinh đề xuất chức năng mới cho phần mềm; quản trị xem và phản hồi
model FeatureRequest {
  id          String               @id @default(cuid())
  studentId   String?
  student     Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// Họ tên và lớp lúc gửi, giữ lại kể cả khi học sinh bị xóa
  authorName  String
  className   String
  title       String
  description String
  status      FeatureRequestStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
}

/// Cuộc bình chọn của lớp do GVCN tạo; mỗi học sinh chọn 1 phương án
model Poll {
  id          String    @id @default(cuid())
  classId     String
  classroom   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId    String?
  question    String
  description String?
  startAt     DateTime
  endAt       DateTime
  /// GV đóng sớm trước endAt
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  options PollOption[]
  votes   PollVote[]

  @@index([classId, startAt])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int        @default(0)
  votes     PollVote[]
}

/// Lựa chọn của học sinh; GV thấy tên, học sinh khác chỉ thấy số lượng
model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([pollId, studentId])
}

/// Tin nhắn phòng chat chung của lớp trong vườn (tự xóa sau 3 ngày; GVCN xóa được tin không phù hợp)
model ChatMessage {
  id         String    @id @default(cuid())
  classId    String
  classroom  Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  authorName String
  text       String
  createdAt  DateTime  @default(now())

  @@index([classId, createdAt])
}

/// Bình chọn tuyên dương hằng tuần: mỗi học sinh bầu 1 bạn cùng lớp (không tự bầu), đổi được trong tuần.
/// Tuyên dương tháng/học kỳ được tính từ số lần được tuyên dương tuần.
model CommendationVote {
  id        String    @id @default(cuid())
  classId   String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// 0h thứ Hai (giờ VN) của tuần bình chọn
  weekStart DateTime
  voterId   String
  voter     Student   @relation("CommendationVoter", fields: [voterId], references: [id], onDelete: Cascade)
  nomineeId String
  nominee   Student   @relation("CommendationNominee", fields: [nomineeId], references: [id], onDelete: Cascade)
  /// Lý do ngắn (vì sao bạn xứng đáng được tuyên dương)
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([voterId, weekStart])
  @@index([classId, weekStart])
}

/// Đăng ký nhận thông báo đẩy (Web Push) của một trình duyệt/thiết bị
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Đã nhắc học sinh làm phiếu ở mốc nào (mỗi mốc chỉ nhắc một lần): kind = "24h" | "3h"
model ReminderLog {
  id        String   @id @default(cuid())
  surveyId  String
  studentId String
  kind      String
  sentAt    DateTime @default(now())
  /// Số thiết bị đã gửi thành công
  delivered Int      @default(0)

  @@unique([surveyId, studentId, kind])
}
