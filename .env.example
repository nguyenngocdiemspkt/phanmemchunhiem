# Chuỗi kết nối PostgreSQL (Neon tự tạo 2 biến này khi gắn vào Vercel)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Khóa bí mật ký phiên đăng nhập: chuỗi ngẫu nhiên dài >= 32 ký tự
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-that-dai"

# Mã dùng một lần ở trang /cai-dat để tạo tài khoản quản trị đầu tiên
SETUP_KEY="ma-cai-dat-bi-mat"
